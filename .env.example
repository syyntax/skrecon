# skrecon / birdseye — API key template.
#
# Copy to `.env` (git-ignored) and fill in. Real secrets NEVER go in the repo,
# in skrecon.toml, or on the command line. `skrecon preflight` reports which
# modules are enabled based on which of these are present.

# ---- v1 providers (confirmed in use) ----
SHODAN_API_KEY=
DEHASHED_API_KEY=
DEHASHED_EMAIL=

# ---- Deferred second-sources (adapters not built in v1; leave blank) ----
# Provide a key here later and the pluggable provider interface will pick it up.
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# HIBP_API_KEY=
